APP_NAME="Summit Station"
# WAJIB DIUBAH sebelum deploy → production
APP_ENV=production
APP_KEY=
# WAJIB false di server (jangan pernah true di production)
APP_DEBUG=false
# Ganti dengan URL production: https://domain-anda.com
APP_URL=https://domain-anda.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# WAJIB: set ke warning atau error di production, jangan info/debug
LOG_LEVEL=warning

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE — Jangan memakai user MySQL 'root' di server.
# Buat user khusus, contoh:
#   CREATE USER 'summit_station'@'localhost' IDENTIFIED BY 'password-kuat';
#   GRANT ALL PRIVILEGES ON summit_station.* TO 'summit_station'@'localhost';
# ──────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
# Di Rumahweb shared hosting, DB_HOST biasanya localhost (bukan 127.0.0.1)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=summit_station
DB_USERNAME=summit_station
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# SESSION — WAJIB: driver harus 'database' agar fitur Active Now berfungsi.
# Pastikan php artisan migrate sudah dijalankan (tabel sessions tersedia).
# WAJIB: SESSION_SECURE_COOKIE=true bila HTTPS aktif (wajib di production).
# SESSION_SAME_SITE: gunakan 'lax' sebagai default aman.
# ──────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# WAJIB: driver queue. Gunakan 'database' bila tidak ada worker async.
# Jalankan: php artisan queue:table && php artisan migrate sebelum deploy.
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────────────────────
# MAIL — Ganti dengan konfigurasi SMTP production Rumahweb.
# MAIL_FROM_ADDRESS harus menggunakan domain production yang valid.
# Jangan biarkan MAIL_MAILER=log di production.
# ──────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.domain-anda.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────────────
# CHECKLIST DEPLOYMENT RUMAHWEB
# Lakukan semua langkah berikut sebelum go-live:
# 1. Isi seluruh variabel di atas dengan nilai production yang benar.
# 2. Jalankan: php artisan key:generate (hanya sekali, simpan APP_KEY dengan aman).
# 3. Jalankan: php artisan migrate --force (backup DB dahulu).
# 4. Jalankan: php artisan config:cache
# 5. Jalankan: php artisan route:cache
# 6. Jalankan: php artisan view:cache
# 7. Pastikan storage/ dan bootstrap/cache/ dapat ditulis oleh web server.
# 8. Jalankan: php artisan storage:link (bila tidak menggunakan disk local private).
# 9. Verifikasi HTTPS aktif sebelum mengaktifkan SESSION_SECURE_COOKIE=true.
# 10. Pastikan cron job terdaftar untuk: php artisan schedule:run
#     (diperlukan untuk notifikasi deadline pengembalian).
# ──────────────────────────────────────────────────────────────────────────────
